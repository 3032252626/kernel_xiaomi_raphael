# 内核编译配置
KERNEL_CONFIG=raphael_defconfig

# 内核打包名字
KERNEL_ZIP_NAME=raphael_lxc-docker_ksu_kernel

# 是否开启lxc-docker
ENABLE_LXC_DOCKER=true

# 是否开启KernelSU
ENABLE_KERNELSU=true
KERNELSU_TAG=main

# 是否开启kvm
ENABLE_KVM=false

# LLVM参数，clang编译不需要
LLVM_CONFIG=n

# 内核镜像文件名
KERNEL_IMAGE_NAME=Image.gz-dtb

# 其他
SWITCH_PYTHON=false
NEED_DTBO=false
